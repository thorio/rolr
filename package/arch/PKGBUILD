# Maintainer: thorou <thorou@chirality.de>

pkgname=rolr
pkgver=0.0.0_dev # patched by CI
pkgrel=1
pkgdesc="Host role manager built on top of ansible"
arch=("x86_64")
url="https://github.com/thorio/$pkgname"
license=("GPL3")
options=("!strip" "!debug")

package() {
	reporoot=$(git rev-parse --show-toplevel)

	install -Dm755 "$reporoot/target/x86_64-unknown-linux-musl/release/rolr" "$pkgdir/usr/bin/rolr"

	install -Dm644 "$reporoot/completions/rolr.bash" "$pkgdir/usr/share/bash-completion/completions/rolr"
	install -Dm644 "$reporoot/completions/_rolr" "$pkgdir/usr/share/zsh/site-functions/_rolr"
	install -Dm644 "$reporoot/completions/rolr.fish" "$pkgdir/usr/share/fish/vendor_completions.d/rolr.fish"
}
